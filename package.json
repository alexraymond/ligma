{
  "name": "ligma",
  "version": "0.2.0",
  "private": true,
  "description": "Autonomous app factory for one person: you direct; it builds; it proves.",
  "license": "MIT",
  "homepage": "https://github.com/alexraymond/ligma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexraymond/ligma.git"
  },
  "bugs": {
    "url": "https://github.com/alexraymond/ligma/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "smoke": "tsx scripts/smoke-models.ts",
    "ligma:pull": "git pull --rebase --autostash",
    "ligma:push": "git push"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@iarna/toml": "^2.2.5",
    "@ligma/core": "workspace:*",
    "@ligma/shared": "workspace:*",
    "@types/node": "^22.10.2",
    "acorn": "^8.14.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
